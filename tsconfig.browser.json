{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    // Type-checks src against each package's browser barrel by resolving #platform
    // with the browser condition. Replaces the base list, so otel is repeated.
    "customConditions": ["otel", "browser"],
    "noEmit": true,
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "incremental": false,
    "lib": ["es2022", "dom", "dom.iterable"],
    "types": ["node"]
  },
  "include": [
    "packages/opentelemetry-core/src/**/*.ts",
    "packages/sdk-trace/src/**/*.ts",
    "packages/opentelemetry-exporter-zipkin/src/**/*.ts",
    "packages/opentelemetry-resources/src/**/*.ts",
    "experimental/packages/sdk-logs/src/**/*.ts",
    "experimental/packages/opentelemetry-instrumentation/src/**/*.ts",
    "experimental/packages/exporter-trace-otlp-http/src/**/*.ts",
    "experimental/packages/exporter-trace-otlp-proto/src/**/*.ts",
    "experimental/packages/exporter-logs-otlp-http/src/**/*.ts",
    "experimental/packages/exporter-logs-otlp-proto/src/**/*.ts",
    "experimental/packages/opentelemetry-exporter-metrics-otlp-http/src/**/*.ts",
    "experimental/packages/opentelemetry-exporter-metrics-otlp-proto/src/**/*.ts"
  ]
}
